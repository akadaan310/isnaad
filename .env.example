# ─────────────────────────────────────────────────────────────
# Supabase is OPTIONAL. With no .env.local at all the studio runs
# fully offline from the mined corpus in /data, and تدبر notes are
# persisted to browser localStorage.
# Fill these in to move notes (and optionally the corpus) into Postgres.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required just for `npm run ingest -- --push-supabase`.
SUPABASE_SERVICE_ROLE_KEY=
